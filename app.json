{
  "displayName": "chirley-test-git",
  "description": "AI-powered Fan Experience Agent for Oracle Red Bull Racing.",
  "rootAgent": "Root agent",
  "audioProcessingConfig": {
    "synthesizeSpeechConfigs": {
      "en-US": {
      },
      "fr-FR": {
      }
    },
    "bargeInConfig": {
      "bargeInAwareness": true
    }
  },
  "loggingSettings": {
    "redactionConfig": {
      "enableRedaction": true
    },
    "audioRecordingConfig": {
    },
    "bigqueryExportSettings": {
      "enabled": true,
      "project": "$env_var",
      "dataset": "$env_var"
    },
    "cloudLoggingSettings": {
      "enableCloudLogging": true
    },
    "conversationLoggingSettings": {
      "retentionWindow": "31536000s"
    },
    "metricAnalysisSettings": {
    }
