  "guardrails": ["Safety Guardrail 1772733891141", "Prompt Guardrail 1772733891141", "F1 Integrity Guardrail"],
  "modelSettings": {
    "model": "gemini-3.1-flash-live"
  },
  "variableDeclarations": [{
    "name": "today",
